-- 1. FONDASI (Services)
local TweenService = game:GetService("TweenService")
local CoreGui = game:GetService("CoreGui")

-- 2. WADAH UTAMA (ScreenGui)
local mainGui = Instance.new("ScreenGui")
mainGui.Name = "TachyonSystem"
mainGui.Parent = CoreGui

-- 3. BAGIAN INTRO
local introFrame = Instance.new("Frame")
introFrame.Size = UDim2.new(1, 0, 1, 0)
introFrame.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
introFrame.BackgroundTransparency = 0 -- Terlihat jelas di awal
introFrame.Parent = mainGui

local introText = Instance.new("TextLabel")
introText.Size = UDim2.new(0, 400, 0, 100)
introText.Position = UDim2.new(0.5, -200, 0.5, -50)
introText.BackgroundTransparency = 1
introText.Text = "TACHYON V1"
introText.TextColor3 = Color3.fromRGB(255, 255, 255)
introText.TextSize = 50
introText.Font = Enum.Font.GothamBold
introText.Parent = introFrame

-- 4. BAGIAN MENU (Disembunyikan dulu)
local menuFrame = Instance.new("Frame")
menuFrame.Size = UDim2.new(400, 300, 400, 200)
menuFrame.Position = UDim2.new(0.5, -150, 0.5, -100)
menuFrame.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
menuFrame.Visible = false -- INI KUNCINYA: Menu tidak terlihat dulu
menuFrame.Parent = mainGui
menuFrame.Active = true -- Membuat frame bisa merespon sentuhan
menuFrame.Draggable = true -- Mengaktifkan fitur geser otomatis

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, 0, 0, 40)
title.Text = "Main Menu"
title.TextColor3 = Color3.fromRGB(255, 255, 255)
title.Parent = menuFrame

-- 5. LOGIKA JALANNYA SCRIPT
-- Munculkan Intro selama 8 detik
print("Memulai Intro...")
task.wait(8) -- Menunggu tepat 8 detik sesuai kemauanmu

-- Animasi Menghilangkan Intro (Fade Out)
local fadeInfo = TweenInfo.new(1, Enum.EasingStyle.Linear)
local fadeAnim = TweenService:Create(introFrame, fadeInfo, {BackgroundTransparency = 1})
local textAnim = TweenService:Create(introText, fadeInfo, {TextTransparency = 1})

fadeAnim:Play()
textAnim:Play()

fadeAnim.Completed:Connect(function()
    introFrame:Destroy() -- Hapus intro kalau sudah selesai biar gak berat
    menuFrame.Visible = true -- MUNCULKAN MENU UTAMA
    print("Menu Utama Muncul!")
end)
