-- === [1. LAYANAN / SERVICES] ===
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local CoreGui = game:GetService("CoreGui")

-- === [2. WADAH UTAMA] ===
local mainGui = Instance.new("ScreenGui")
mainGui.Name = "TachyonV1_Project"
mainGui.Parent = CoreGui

-- === [3. TAHAP INTRO (TULISAN & BACKGROUND)] ===
local introFrame = Instance.new("Frame")
introFrame.Size = UDim2.new(1, 0, 1, 0)
introFrame.BackgroundColor3 = Color3.fromRGB(20, 20, 20) -- Background Gelap
introFrame.Parent = mainGui

local introText = Instance.new("TextLabel")
introText.Size = UDim2.new(0, 500, 0, 100)
introText.Position = UDim2.new(0.5, -400, 0.5, -50) -- Agak ke kiri sesuai request
introText.Text = "TACHYON V1 - LOADING"
introText.TextColor3 = Color3.fromRGB(255, 255, 255)
introText.BackgroundTransparency = 1
introText.TextSize = 50
introText.Parent = introFrame

-- === [4. TAHAP MENU UTAMA (SETELAH INTRO)] ===
local menuFrame = Instance.new("Frame")
menuFrame.Size = UDim2.new(0.28, 300, 2, 400)
menuFrame.Position = UDim2.new(0.5, -150, 0.5, -200)
menuFrame.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
menuFrame.Visible = false -- Sembunyi dulu pas intro
menuFrame.Parent = mainGui

-- TOP BAR & TOMBOL MINIMIZE (Coretan Hitam)
local topBar = Instance.new("Frame")
topBar.Size = UDim2.new(1, 0, 0, 30)
topBar.BackgroundColor3 = Color3.fromRGB(150, 150, 150)
topBar.Parent = menuFrame

local minBtn = Instance.new("TextButton")
minBtn.Size = UDim2.new(0, 30, 0, 30)
minBtn.Position = UDim2.new(1, -30, 0, 0)
minBtn.Text = "-"
minBtn.BackgroundColor3 = Color3.fromRGB(0, 0, 0) -- Tombol Hitam
minBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
minBtn.Parent = topBar

-- DAFTAR TOMBOL MERAH (TCO, Settings, dll)
local buttonContainer = Instance.new("Frame")
buttonContainer.Size = UDim2.new(1, 0, 1, -30)
buttonContainer.Position = UDim2.new(0, 0, 0, 30)
buttonContainer.BackgroundTransparency = 1
buttonContainer.Parent = menuFrame

local layout = Instance.new("UIListLayout")
layout.Padding = UDim.new(0, 8)
layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
layout.Parent = buttonContainer

local function createMenuButton(name)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0, 250, 0, 40)
    btn.Text = name
    btn.BackgroundColor3 = Color3.fromRGB(200, 0, 0) -- Merah
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Parent = buttonContainer
    return btn
end

local tcoBtn = createMenuButton("TCO")
local settingBtn = createMenuButton("Settings")

-- === [5. LOGIKA JALANNYA SCRIPT] ===

-- Animasi Intro
task.wait(3) -- Tunggu 3 detik
TweenService:Create(introFrame, TweenInfo.new(1), {BackgroundTransparency = 1}):Play()
TweenService:Create(introText, TweenInfo.new(1), {TextTransparency = 1}):Play()

task.wait(1)
introFrame:Destroy()
menuFrame.Visible = true -- Munculkan menu

-- Efek Pelangi (Rainbow)
RunService.RenderStepped:Connect(function()
    local t = tick()
    menuFrame.BorderColor3 = Color3.fromHSV(t * 0.5 % 1, 1, 1)
end)

-- Logika Minimize
local isMinimized = false
minBtn.MouseButton1Click:Connect(function()
    if not isMinimized then
        buttonContainer.Visible = false
        menuFrame:TweenSize(UDim2.new(0, 300, 0, 30), "Out", "Quart", 0.3)
        minBtn.Text = "+"
        isMinimized = true
    else
        menuFrame:TweenSize(UDim2.new(0, 300, 0, 400), "Out", "Quart", 0.3)
        task.wait(0.3)
        buttonContainer.Visible = true
        minBtn.Text = "-"
        isMinimized = false
    end
end)
